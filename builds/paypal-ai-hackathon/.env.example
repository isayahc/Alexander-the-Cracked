# PayPilot configuration. Copy to .env and fill in what you need.
# With nothing set, PayPilot runs in DEMO mode (scripted PayPal data, no network).

# PayPal developer platform - free sandbox credentials from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to the sandbox; do not point this at live PayPal.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI planner: "local" (default, deterministic, no key) or "openai" (any
# OpenAI-compatible chat-completions endpoint).
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
